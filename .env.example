# Sao chép file này thành .env rồi điền giá trị. KHÔNG đưa file .env lên GitHub.

# --- Cơ sở dữ liệu (BẮT BUỘC: PostgreSQL) ---
# PostgreSQL cài trên máy: tạo cơ sở dữ liệu tên neu_feedback rồi sửa MAT_KHAU cho đúng.
# Mật khẩu nên chỉ gồm chữ và số (ký tự đặc biệt như @ # / phải mã hóa trong đường dẫn).
DATABASE_URL=postgresql+psycopg://postgres:MAT_KHAU@localhost:5432/neu_feedback
# Dịch vụ trên mạng (ví dụ Supabase): Dashboard → Connect → "Session pooler" → dán chuỗi URI vào đây.

# --- Bảo mật --- (tạo chuỗi ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
ALLOWED_EMAIL_DOMAINS=neu.edu.vn,st.neu.edu.vn
CORS_ORIGINS=*

# --- AI (Gemini) --- lấy key miễn phí tại https://aistudio.google.com/apikey — để trống thì chạy chế độ demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 0 = tắt thinking để trả lời nhanh (mặc định); -1 = để mô hình tự quyết
GEMINI_THINKING_BUDGET=0
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Khác ---
CURRENT_SEMESTER=HK1 2026-2027
SEMESTER_START=2026-08-03
MAX_UPLOAD_MB=20

# Ngưỡng độ giống câu hỏi (0–1): gợi ý gộp nhóm / tự động trả lời (khi dùng Gemini)
SIMILARITY_THRESHOLD=0.85
AUTO_ANSWER_THRESHOLD=0.92
